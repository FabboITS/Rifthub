# ─── Django ────────────────────────────────────────────────────────────
# Chiave segreta: in produzione generane una nuova, es.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
# 1 = modalità debug (solo sviluppo), 0 = produzione
DJANGO_DEBUG=0
# Host accettati dal backend (separati da virgola)
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origini abilitate al CORS (servono solo se il frontend non passa dal proxy nginx)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 1 = carica i dati demo all'avvio (idempotente)
SEED_DEMO=1

# ─── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=rifthub
POSTGRES_USER=rifthub
POSTGRES_PASSWORD=rifthub
# Host del DB: "db" in Docker. Se vuoto il backend usa SQLite (sviluppo/test).
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── AI ────────────────────────────────────────────────────────────────
# Provider: ollama (default, locale) | openai | anthropic | openrouter | fake (solo test/demo offline)
AI_PROVIDER=ollama
# Modello: per Ollama llama3.2:3b (leggero) o qwen2.5:7b (migliore, più RAM).
# Se vuoto si usa il default del provider (openai: gpt-4o-mini, anthropic: claude-opus-5-5,
# openrouter: openai/gpt-4o-mini).
AI_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
# Timeout (secondi) per ogni chiamata al provider AI
AI_TIMEOUT=120
# Chiavi dei provider online (opzionali)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─── Riot Games API (opzionale) ────────────────────────────────────────
# Senza chiave si usa un client mock deterministico.
# Le development key scadono ogni 24h: rigenerale su https://developer.riotgames.com
RIOT_API_KEY=
